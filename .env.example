# LLM provider (decision 2026-09-22: API only, via OpenRouter or DeepSeek — no local llama-server)
OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=  (reserved: ADR-0004 cost fallback, not used by the code yet)

# Bibliographic sources (needed from M1 onwards, not for M0)
OPENALEX_API_KEY=
# Sent to OpenAlex/Unpaywall/publishers in the User-Agent; identifies polite API use.
PORTOLAN_CONTACT_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=

# Neo4j — the graph store (ADR-0005). NEO4J_PASSWORD is required by docker compose;
# NEO4J_URI is only used outside compose (compose points the backend at the neo4j service).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Backend (optional): graph store and whether to load the golden mini-graph when empty
# PORTOLAN_STORE=neo4j (default) or memory
# PORTOLAN_SEED_GOLDEN=true

# Local only: directory holding the private design notes (spec.md, ontology.md,
# data-sources.md, architecture.md) that the docs refer to as $PORTOLAN_NOTES_DIR.
PORTOLAN_NOTES_DIR=
